<%- include('partials/header', { title: 'Sales' }) %>
<section class="page-heading"><div><p class="eyebrow">Stock out</p><h1>Sales</h1><p class="muted">Record customer orders and let the system protect your stock.</p></div></section>
<section class="stats-grid">
  <div class="stat-card"><span class="stat-icon green">D</span><div><p>Today</p><strong><%= currencySymbol %><%= formatMoney(summary.today_revenue) %></strong><small><%= summary.today_count %> transactions</small></div></div>
  <div class="stat-card"><span class="stat-icon blue">W</span><div><p>This week</p><strong><%= currencySymbol %><%= formatMoney(summary.week_revenue) %></strong><small><%= summary.week_count %> transactions · Mon-Sun</small></div></div>
  <div class="stat-card"><span class="stat-icon orange">M</span><div><p>This month</p><strong><%= currencySymbol %><%= formatMoney(summary.month_revenue) %></strong><small><%= summary.month_count %> transactions</small></div></div>
  <div class="stat-card"><span class="stat-icon purple">Y</span><div><p>This year</p><strong><%= currencySymbol %><%= formatMoney(summary.year_revenue) %></strong><small><%= summary.year_count %> transactions</small></div></div>
</section>
<section class="period-chart-grid">
  <% const chartPeriods = [
    { title: 'Daily sales', caption: 'Latest 7 days', values: trends.daily },
    { title: 'Weekly sales', caption: 'Latest 8 weeks', values: trends.weekly },
    { title: 'Monthly sales', caption: 'Latest 12 months', values: trends.monthly },
    { title: 'Yearly sales', caption: 'Latest 5 years', values: trends.yearly }
  ]; %>
  <% chartPeriods.forEach(period => { const maxRevenue = Math.max(0, ...period.values.map(point => Number(point.revenue))); %>
  <section class="panel period-chart">
    <div class="panel-heading"><div><p class="eyebrow"><%= period.caption %></p><h2><%= period.title %></h2></div></div>
    <% if (!latestSaleDate) { %>
      <div class="empty-state">Sales will appear here after your first transaction.</div>
    <% } else { %>
      <div class="chart-bars" role="img" aria-label="<%= period.title %> revenue trend">
        <% period.values.forEach(point => { const height = maxRevenue ? Math.max(3, Number(point.revenue) / maxRevenue * 100) : 3; %>
        <div class="chart-column" title="<%= point.label %>: <%= currencySymbol %><%= formatMoney(point.revenue) %> · <%= point.transactions %> transactions">
          <div class="chart-bar-track"><span class="chart-bar-fill" style="height: <%= height %>%"></span></div>
          <strong><%= currencySymbol %><%= formatRoundedMoney(point.revenue) %></strong>
          <small><%= point.label %></small>
        </div>
        <% }) %>
      </div>
    <% } %>
  </section>
  <% }) %>
</section>
<p class="chart-note">Charts show historical windows ending on the latest recorded sale date<% if (latestSaleDate) { %> (<%= new Date(`${latestSaleDate}T00:00:00Z`).toLocaleDateString(undefined, { timeZone: 'UTC' }) %>)<% } %>. Summary cards above always reflect today, this week, this month, and this year.</p>
<% if (message) { %><div class="alert success"><%= message %></div><% } %><% if (error) { %><div class="alert error"><%= error %></div><% } %><section class="panel form-panel"><div class="panel-heading"><div><p class="eyebrow">New transaction</p><h2>Record a sale</h2></div><span class="helper">Sales are saved to the database; totals update from their recorded dates (<%= currencyCode %>).</span></div><form class="form-grid" action="/sales" method="post"><label>Customer name<input name="customer_name" placeholder="Walk-in customer" required></label><label>Product<select name="product_id" required><option value="">Choose product</option><%- products.map(p => `<option value="${p.id}">${p.name} · ${p.stock} available</option>`).join('') %></select></label><label>Quantity<input type="number" name="quantity" min="1" step="1" required></label><div class="form-end"><button class="button primary" type="submit">Record sale</button></div></form></section><section class="panel"><div class="panel-heading"><div><p class="eyebrow">History</p><h2>Recent sales</h2></div></div><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Customer</th><th>Items</th><th>Date</th><th>Total</th></tr></thead><tbody><% sales.forEach(sale => { %><tr><td><b>Sale #<%= sale.id %></b></td><td><%= sale.customer_name %></td><td><%= sale.items %></td><td><%= new Date(sale.sold_at).toLocaleDateString() %></td><td><strong><%= currencySymbol %><%= formatMoney(sale.total) %></strong></td></tr><% }) %><% if (!sales.length) { %><tr><td colspan="5" class="muted">No sales recorded yet.</td></tr><% } %></tbody></table></div></section>
<%- include('partials/footer') %>

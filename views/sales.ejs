<%- include('partials/header', { title: 'Sales' }) %>
<section class="page-heading"><div><p class="eyebrow">Stock out</p><h1>Sales</h1><p class="muted">Record customer orders and let the system protect your stock.</p></div></section>
<% if (message) { %><div class="alert success"><%= message %></div><% } %><% if (error) { %><div class="alert error"><%= error %></div><% } %><section class="panel form-panel"><div class="panel-heading"><div><p class="eyebrow">New transaction</p><h2>Record a sale</h2></div><span class="helper">Price is taken from the product catalog</span></div><form class="form-grid" action="/sales" method="post"><label>Customer name<input name="customer_name" placeholder="Walk-in customer" required></label><label>Product<select name="product_id" required><option value="">Choose product</option><%- products.map(p => `<option value="${p.id}">${p.name} · ${p.stock} available</option>`).join('') %></select></label><label>Quantity<input type="number" name="quantity" min="1" required></label><div class="form-end"><button class="button primary" type="submit">Record sale</button></div></form></section><section class="panel"><div class="panel-heading"><div><p class="eyebrow">History</p><h2>Recent sales</h2></div></div><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Customer</th><th>Items</th><th>Date</th><th>Total</th></tr></thead><tbody><% sales.forEach(sale => { %><tr><td><b>Sale #<%= sale.id %></b></td><td><%= sale.customer_name %></td><td><%= sale.items %></td><td><%= new Date(sale.sold_at).toLocaleDateString() %></td><td><strong>$<%= Number(sale.total).toFixed(2) %></strong></td></tr><% }) %></tbody></table></div></section>
<%- include('partials/footer') %>

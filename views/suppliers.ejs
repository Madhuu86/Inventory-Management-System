<%- include('partials/header', { title: 'Suppliers' }) %>
<section class="page-heading"><div><p class="eyebrow">Relationships</p><h1>Suppliers</h1><p class="muted">Keep the people behind your inventory close at hand.</p></div></section>
<% if (message) { %><div class="alert success"><%= message %></div><% } %><% if (error) { %><div class="alert error"><%= error %></div><% } %><section class="panel form-panel"><div class="panel-heading"><div><p class="eyebrow">New record</p><h2>Add supplier</h2></div></div><form class="form-grid" action="/suppliers" method="post"><label>Supplier name<input name="name" placeholder="Company name" required></label><label>Email<input type="email" name="email" placeholder="orders@company.com"></label><label>Phone<input name="phone" placeholder="Contact number"></label><label>Address<input name="address" placeholder="Business address"></label><div class="form-end"><button class="button primary" type="submit">Save supplier</button></div></form></section><section class="panel"><div class="panel-heading"><div><p class="eyebrow">Your network</p><h2>Supplier directory <span class="count"><%= suppliers.length %></span></h2></div></div><div class="table-wrap"><table><thead><tr><th>Supplier</th><th>Contact</th><th>Address</th><th>Products</th></tr></thead><tbody><% suppliers.forEach(supplier => { %><tr><td><b><%= supplier.name %></b><small>Added <%= new Date(supplier.created_at).toLocaleDateString() %></small></td><td><b><%= supplier.email || '—' %></b><small><%= supplier.phone || 'No phone' %></small></td><td><%= supplier.address || '—' %></td><td><span class="count"><%= supplier.product_count %></span></td></tr><% }) %></tbody></table></div></section>
<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Overview' }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow"><%= new Date().toLocaleDateString(undefined, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></p>
    <h1>Good morning, <%= user.name.split(' ')[0] %>.</h1>
    <p class="muted">Here is what is happening across your inventory today.</p>
  </div>
  <a class="button primary" href="/sales">Record a sale <span>→</span></a>
</section>

<section class="stats-grid">
  <div class="stat-card"><span class="stat-icon orange">□</span><div><p>Total products</p><strong><%= stats.products %></strong><small>Active SKUs</small></div></div>
  <div class="stat-card"><span class="stat-icon blue">◉</span><div><p>Inventory units</p><strong><%= stats.units %></strong><small><%= hasDemoData ? 'Illustrative sample stock' : 'Across all products' %></small></div></div>
  <div class="stat-card"><span class="stat-icon green">◎</span><div><p>Suppliers</p><strong><%= stats.suppliers %></strong><small>Trusted partners</small></div></div>
  <div class="stat-card"><span class="stat-icon purple">↗</span><div><p>Total revenue</p><strong><%= currencySymbol %><%= formatMoney(stats.revenue) %></strong><small>All recorded sales · <%= currencyCode %></small></div></div>
</section>

<div class="content-grid">
  <section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">Needs attention</p><h2>Low stock items</h2></div><a href="/products" class="text-link">View all →</a></div>
    <% if (!lowStock.length) { %>
      <div class="empty-state">Everything is comfortably stocked.</div>
    <% } else { %>
      <div class="table-wrap"><table><thead><tr><th>Product</th><th>Category</th><th>On hand</th><th>Status</th></tr></thead><tbody>
      <% lowStock.forEach(item => { %>
        <tr><td><b><%= item.name %></b><small><%= item.sku %></small></td><td><%= item.category_name %></td><td><strong><%= item.stock %></strong> / <%= item.reorder_level %></td><td><span class="badge warning">Reorder</span></td></tr>
      <% }) %>
      </tbody></table></div>
    <% } %>
  </section>
  <section class="panel accent-panel">
    <div class="panel-heading"><div><p class="eyebrow">Quick actions</p><h2>Keep things moving</h2></div></div>
    <div class="quick-links">
      <a href="/products"><span>+</span><div><b>Add a product</b><small>Create a new SKU</small></div><i>→</i></a>
      <a href="/purchases"><span>↓</span><div><b>Log a purchase</b><small>Restock inventory</small></div><i>→</i></a>
      <a href="/reports"><span>◫</span><div><b>View reports</b><small>Understand performance</small></div><i>→</i></a>
    </div>
  </section>
</div>

<section class="panel">
  <div class="panel-heading"><div><p class="eyebrow">Sales performance</p><h2>Most sold products</h2></div><a href="/reports" class="text-link">View reports →</a></div>
  <% if (!popularProducts.length) { %>
    <div class="empty-state">No product sales are recorded yet.</div>
  <% } else { %>
    <div class="table-wrap"><table><thead><tr><th>Product</th><th>SKU</th><th>Units sold</th></tr></thead><tbody>
    <% popularProducts.forEach(item => { %>
      <tr><td><b><%= item.name %></b></td><td><%= item.sku %></td><td><strong><%= Number(item.units_sold).toLocaleString() %></strong></td></tr>
    <% }) %>
    </tbody></table></div>
  <% } %>
</section>

<section class="panel">
  <div class="panel-heading"><div><p class="eyebrow">Recent activity</p><h2>Latest transactions</h2></div><a href="/sales" class="text-link">All sales →</a></div>
  <div class="activity-grid">
    <div><h3>Sales</h3>
      <% recentSales.forEach(sale => { %><div class="activity-row"><span class="activity-icon green">↑</span><div><b><%= sale.customer_name %></b><small><%= sale.items %> item(s) · <%= new Date(sale.sold_at).toLocaleDateString() %></small></div><strong>+<%= currencySymbol %><%= formatMoney(sale.total) %></strong></div><% }) %>
      <% if (!recentSales.length) { %><p class="muted">No sales recorded yet.</p><% } %>
    </div>
    <div><h3>Purchases</h3>
      <% recentPurchases.forEach(purchase => { %><div class="activity-row"><span class="activity-icon blue">↓</span><div><b><%= purchase.supplier_name %></b><small>Purchase #<%= purchase.id %> · <%= new Date(purchase.purchased_at).toLocaleDateString() %></small></div><strong><%= currencySymbol %><%= formatMoney(purchase.total) %></strong></div><% }) %>
      <% if (!recentPurchases.length) { %><p class="muted">No purchases recorded yet.</p><% } %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Categories' }) %>
<section class="page-heading"><div><p class="eyebrow">Catalog structure</p><h1>Categories</h1><p class="muted">Group products so your inventory stays easy to scan.</p></div></section>
<% if (message) { %><div class="alert success"><%= message %></div><% } %><% if (error) { %><div class="alert error"><%= error %></div><% } %><div class="two-column"><section class="panel form-panel"><div class="panel-heading"><div><p class="eyebrow">New record</p><h2>Add category</h2></div></div><form action="/categories" method="post"><label>Category name<input name="name" placeholder="e.g. Appliances" required></label><label>Description<textarea name="description" rows="4" placeholder="What belongs here?"></textarea></label><button class="button primary" type="submit">Save category</button></form></section><section class="panel"><div class="panel-heading"><div><p class="eyebrow">Organization</p><h2>All categories</h2></div></div><div class="list-cards"><% categories.forEach(category => { %><div class="list-card"><span class="list-icon orange">◈</span><div><b><%= category.name %></b><small><%= category.description || 'No description' %></small></div><strong><%= category.product_count %><small> products</small></strong></div><% }) %></div></section></div>
<%- include('partials/footer') %>

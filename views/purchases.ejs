<%- include('partials/header', { title: 'Purchases' }) %>
<section class="page-heading"><div><p class="eyebrow">Stock in</p><h1>Purchases</h1><p class="muted">Record incoming stock and keep quantities current.</p></div></section>
<% if (message) { %><div class="alert success"><%= message %></div><% } %><% if (error) { %><div class="alert error"><%= error %></div><% } %>
<section class="panel form-panel">
  <div class="panel-heading"><div><p class="eyebrow">New request</p><h2>Request supplier stock</h2></div><span class="helper">Stock is added after supplier confirmation and receipt</span></div>
  <form class="form-grid" action="/purchases" method="post">
    <label>Supplier<select id="supplier-select" name="supplier_id" required><option value="">Choose supplier</option><% suppliers.forEach(supplier => { %><option value="<%= supplier.id %>"><%= supplier.name %></option><% }) %></select></label>
    <label>Product<select id="purchase-product" name="product_id" required><option value="">Choose product</option><% products.forEach(product => { %><option value="<%= product.id %>" data-supplier="<%= product.supplier_id %>"><%= product.name %> (<%= product.sku %>) · <%= currencySymbol %><%= formatMoney(product.supplier_unit_cost) %> · <%= product.supplier_stock %> available</option><% }) %></select></label>
    <label>Quantity<input type="number" name="quantity" min="1" required></label>
    <div class="form-end"><button class="button primary" type="submit">Send request</button></div>
  </form>
</section>
<section class="panel">
  <div class="panel-heading"><div><p class="eyebrow">Request history</p><h2>Supplier requests</h2></div></div>
  <div class="table-wrap"><table>
    <thead><tr><th>Reference</th><th>Supplier</th><th>Items</th><th>Date</th><th>Total</th><th>Status</th><th></th></tr></thead>
    <tbody><% purchases.forEach(purchase => { %>
      <tr>
        <td><b>Request #<%= purchase.id %></b></td><td><%= purchase.supplier_name %></td><td><%= purchase.items || '—' %></td>
        <td><%= new Date(purchase.purchased_at).toLocaleDateString() %></td><td><strong><%= currencySymbol %><%= formatMoney(purchase.total) %></strong></td>
        <td><span class="count"><%= purchase.status %></span></td>
        <td><% if (purchase.status === 'available') { %><form action="/purchases/<%= purchase.id %>/receive" method="post"><button class="button primary" type="submit">Receive stock</button></form><% } %></td>
      </tr>
    <% }) %></tbody>
  </table></div>
</section>
<script>
const supplierSelect = document.getElementById('supplier-select');
const productSelect = document.getElementById('purchase-product');
supplierSelect.addEventListener('change', () => {
  [...productSelect.options].forEach(option => {
    option.hidden = option.value !== '' && option.dataset.supplier !== supplierSelect.value;
    if (option.hidden && option.selected) productSelect.value = '';
  });
});
</script>
<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Purchases' }) %>
<section class="page-heading"><div><p class="eyebrow">Stock in</p><h1>Purchases</h1><p class="muted">Record incoming stock and keep quantities current.</p></div></section>
<% if (message) { %><div class="alert success"><%= message %></div><% } %><% if (error) { %><div class="alert error"><%= error %></div><% } %><section class="panel form-panel"><div class="panel-heading"><div><p class="eyebrow">New transaction</p><h2>Log a purchase</h2></div><span class="helper">Stock is updated automatically</span></div><form class="form-grid" action="/purchases" method="post"><label>Supplier<select name="supplier_id" required><option value="">Choose supplier</option><%- suppliers.map(s => `<option value="${s.id}">${s.name}</option>`).join('') %></select></label><label>Product<select name="product_id" required><option value="">Choose product</option><%- products.map(p => `<option value="${p.id}">${p.name} (${p.sku})</option>`).join('') %></select></label><label>Quantity<input type="number" name="quantity" min="1" required></label><label>Unit cost<input type="number" name="unit_cost" min="0" step="0.01" placeholder="0.00" required></label><div class="form-end"><button class="button primary" type="submit">Record purchase</button></div></form></section><section class="panel"><div class="panel-heading"><div><p class="eyebrow">History</p><h2>Recent purchases</h2></div></div><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Supplier</th><th>Date</th><th>Total</th></tr></thead><tbody><% purchases.forEach(purchase => { %><tr><td><b>Purchase #<%= purchase.id %></b></td><td><%= purchase.supplier_name %></td><td><%= new Date(purchase.purchased_at).toLocaleDateString() %></td><td><strong>$<%= Number(purchase.total).toFixed(2) %></strong></td></tr><% }) %></tbody></table></div></section>
<%- include('partials/footer') %>

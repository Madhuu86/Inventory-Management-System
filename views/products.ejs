<%- include('partials/header', { title: 'Products' }) %>
<section class="page-heading"><div><p class="eyebrow">Catalog</p><h1>Products</h1><p class="muted">Review supplier listings, set retail prices, and monitor store stock.</p></div></section>
<% if (message) { %><div class="alert success"><%= message %></div><% } %><% if (error) { %><div class="alert error"><%= error %></div><% } %>
<section class="panel">
  <div class="panel-heading"><div><p class="eyebrow">All inventory</p><h2>Product catalog <span class="count"><%= products.length %></span></h2></div></div>
  <% const productCategories = [...new Set(products.map(product => product.category_name).filter(Boolean))].sort(); %>
  <% const productSuppliers = [...new Set(products.map(product => product.supplier_name).filter(Boolean))].sort(); %>
  <div class="product-filters">
    <label for="product-search">Search products<input id="product-search" type="search" placeholder="Name or SKU"></label>
    <label for="category-filter">Category<select id="category-filter"><option value="">All categories</option><% productCategories.forEach(category => { %><option value="<%= category %>"><%= category %></option><% }) %></select></label>
    <label for="supplier-filter">Supplier<select id="supplier-filter"><option value="">All suppliers</option><% productSuppliers.forEach(supplier => { %><option value="<%= supplier %>"><%= supplier %></option><% }) %></select></label>
    <label for="stock-filter">Stock status<select id="stock-filter"><option value="">All stock</option><option value="low">Low stock</option><option value="healthy">In stock</option></select></label>
    <button class="button" id="reset-product-filters" type="button">Clear filters</button>
  </div>
  <p class="filter-summary" id="product-result-count" aria-live="polite"></p>
  <div class="table-wrap"><table>
    <thead><tr><th>Product / SKU</th><th>Category</th><th>Supplier</th><th>Supplier cost</th><th>Retail price</th><th>Available</th><th>Store stock</th><th></th></tr></thead>
    <tbody id="product-rows"><% products.forEach(product => { %>
      <tr data-name="<%= product.name %> <%= product.sku %>" data-category="<%= product.category_name %>" data-supplier="<%= product.supplier_name || '' %>" data-stock-status="<%= product.stock <= product.reorder_level ? 'low' : 'healthy' %>">
        <td><b><%= product.name %></b><small><%= product.sku %></small></td>
        <td><%= product.category_name %></td>
        <td><%= product.supplier_name || '—' %></td>
        <td><%= currencySymbol %><%= formatMoney(product.supplier_unit_cost) %></td>
        <td><form action="/products/<%= product.id %>/price" method="post" class="inline-form"><input aria-label="Retail price" type="number" name="price" min="<%= product.supplier_unit_cost %>" step="0.01" value="<%= Number(product.price).toFixed(2) %>" required><button class="table-action" title="Update retail price">✓</button></form></td>
        <td><%= product.supplier_stock %></td>
        <td><span class="stock-number <%= product.stock <= product.reorder_level ? 'low' : '' %>"><%= product.stock %></span></td>
        <td><form action="/products/<%= product.id %>/delete" method="post" onsubmit="return confirm('Delete this product?')"><button class="table-action" title="Delete">×</button></form></td>
      </tr>
    <% }) %><tr id="no-product-results" hidden><td colspan="8" class="muted">No products match these filters.</td></tr></tbody>
  </table></div>
</section>
<script>
const productRows = [...document.querySelectorAll('#product-rows tr[data-name]')];
const searchInput = document.getElementById('product-search');
const categoryFilter = document.getElementById('category-filter');
const supplierFilter = document.getElementById('supplier-filter');
const stockFilter = document.getElementById('stock-filter');
const resultCount = document.getElementById('product-result-count');
const noResults = document.getElementById('no-product-results');

function filterProducts() {
  const search = searchInput.value.trim().toLocaleLowerCase();
  const category = categoryFilter.value;
  const supplier = supplierFilter.value;
  const stockStatus = stockFilter.value;
  let visibleCount = 0;

  productRows.forEach(row => {
    const matches = row.dataset.name.toLocaleLowerCase().includes(search)
      && (!category || row.dataset.category === category)
      && (!supplier || row.dataset.supplier === supplier)
      && (!stockStatus || row.dataset.stockStatus === stockStatus);
    row.hidden = !matches;
    if (matches) visibleCount += 1;
  });

  noResults.hidden = visibleCount > 0;
  resultCount.textContent = `${visibleCount} of ${productRows.length} products`;
}

[searchInput, categoryFilter, supplierFilter, stockFilter].forEach(filter => {
  filter.addEventListener(filter === searchInput ? 'input' : 'change', filterProducts);
});
document.getElementById('reset-product-filters').addEventListener('click', () => {
  searchInput.value = '';
  categoryFilter.value = '';
  supplierFilter.value = '';
  stockFilter.value = '';
  filterProducts();
});
filterProducts();
</script>
<%- include('partials/footer') %>

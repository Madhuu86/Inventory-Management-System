<%- include('partials/header', { title: 'Products' }) %>
<section class="page-heading"><div><p class="eyebrow">Catalog</p><h1>Products</h1><p class="muted">Manage your product catalog and stock thresholds.</p></div><button class="button primary" onclick="document.getElementById('product-form').scrollIntoView({behavior:'smooth'})">+ Add product</button></section>
<% if (message) { %><div class="alert success"><%= message %></div><% } %><% if (error) { %><div class="alert error"><%= error %></div><% } %>
<section class="panel form-panel" id="product-form"><div class="panel-heading"><div><p class="eyebrow">New record</p><h2>Add product</h2></div></div><form class="form-grid" action="/products" method="post"><label>Product name<input name="name" placeholder="e.g. Wireless keyboard" required></label><label>SKU<input name="sku" placeholder="e.g. KEY-001" required></label><label>Category<select name="category_id" required><option value="">Choose category</option><%- categories.map(c => `<option value="${c.id}">${c.name}</option>`).join('') %></select></label><label>Supplier<select name="supplier_id"><option value="">Choose supplier</option><%- suppliers.map(s => `<option value="${s.id}">${s.name}</option>`).join('') %></select></label><label>Unit price<input type="number" name="price" min="0" step="0.01" placeholder="0.00" required></label><label>Opening stock<input type="number" name="stock" min="0" value="0" required></label><label>Reorder level<input type="number" name="reorder_level" min="0" value="5" required></label><div class="form-end"><button class="button primary" type="submit">Save product</button></div></form></section>
<section class="panel"><div class="panel-heading"><div><p class="eyebrow">All inventory</p><h2>Product catalog <span class="count"><%= products.length %></span></h2></div></div><div class="table-wrap"><table><thead><tr><th>Product / SKU</th><th>Category</th><th>Supplier</th><th>Price</th><th>Stock</th><th></th></tr></thead><tbody><% products.forEach(product => { %><tr><td><b><%= product.name %></b><small><%= product.sku %></small></td><td><%= product.category_name %></td><td><%= product.supplier_name || '—' %></td><td>$<%= Number(product.price).toFixed(2) %></td><td><span class="stock-number <%= product.stock <= product.reorder_level ? 'low' : '' %>"><%= product.stock %></span></td><td><form action="/products/<%= product.id %>/delete" method="post" onsubmit="return confirm('Delete this product?')"><button class="table-action" title="Delete">×</button></form></td></tr><% }) %></tbody></table></div></section>
<%- include('partials/footer') %>

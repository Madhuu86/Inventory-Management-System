<%- include('partials/header', { title: 'Supplier workspace' }) %>
<section class="page-heading"><div><p class="eyebrow">Supplier portal</p><h1>Your workspace</h1><p class="muted">Manage your catalog, availability, and incoming stock requests.</p></div></section>
<% if (message) { %><div class="alert success"><%= message %></div><% } %><% if (error) { %><div class="alert error"><%= error %></div><% } %>
<section class="panel form-panel">
  <div class="panel-heading"><div><p class="eyebrow">Supplier catalog</p><h2>Add a product</h2></div></div>
  <form class="form-grid" action="/supplier/products" method="post">
    <label>Product name<input name="name" required></label>
    <label>SKU<input name="sku" required></label>
    <label>Category<select name="category_id" required><option value="">Choose category</option><% categories.forEach(category => { %><option value="<%= category.id %>"><%= category.name %></option><% }) %></select></label>
    <label>Your unit cost (<%= currencyCode %>)<input type="number" name="supplier_unit_cost" min="0" step="0.01" required></label>
    <label>Available quantity<input type="number" name="supplier_stock" min="0" value="0" required></label>
    <div class="form-end"><button class="button primary" type="submit">Add to catalog</button></div>
  </form>
</section>
<section class="panel">
  <div class="panel-heading"><div><p class="eyebrow">Your listings</p><h2>Catalog <span class="count"><%= products.length %></span></h2></div></div>
  <div class="table-wrap"><table>
    <thead><tr><th>Product</th><th>Category</th><th>Your cost</th><th>Available</th><th>Retail price</th><th>Store stock</th></tr></thead>
    <tbody><% products.forEach(product => { %>
      <tr>
        <td><b><%= product.name %></b><small><%= product.sku %></small></td><td><%= product.category_name || '—' %></td>
        <td><%= currencySymbol %><%= formatMoney(product.supplier_unit_cost) %></td>
        <td><form class="inline-form" action="/supplier/products/<%= product.id %>/update" method="post"><input aria-label="Unit cost" type="number" name="supplier_unit_cost" min="0" step="0.01" value="<%= Number(product.supplier_unit_cost).toFixed(2) %>" required><input aria-label="Available quantity" type="number" name="supplier_stock" min="0" value="<%= product.supplier_stock %>" required><button class="table-action" title="Save catalog changes">✓</button></form></td>
        <td><%= currencySymbol %><%= formatMoney(product.price) %></td><td><%= product.stock %> in store</td>
      </tr>
    <% }) %></tbody>
  </table></div>
</section>
<section class="panel">
  <div class="panel-heading"><div><p class="eyebrow">Purchase requests</p><h2>Requests from the store</h2></div></div>
  <div class="table-wrap"><table>
    <thead><tr><th>Reference</th><th>Items</th><th>Date</th><th>Total</th><th>Status</th><th>Reply</th></tr></thead>
    <tbody><% requests.forEach(request => { %>
      <tr>
        <td><b>Request #<%= request.id %></b></td><td><%= request.items || '—' %></td><td><%= new Date(request.purchased_at).toLocaleDateString() %></td>
        <td><%= currencySymbol %><%= formatMoney(request.total) %></td><td><span class="count"><%= request.status %></span></td>
        <td><% if (request.status === 'pending') { %><form class="inline-form" action="/supplier/requests/<%= request.id %>/respond" method="post"><button class="button primary" name="status" value="available" type="submit">Available</button><button class="button" name="status" value="insufficient" type="submit">Insufficient</button></form><% } else { %>Replied<% } %></td>
      </tr>
    <% }) %></tbody>
  </table></div>
</section>
<%- include('partials/footer') %>

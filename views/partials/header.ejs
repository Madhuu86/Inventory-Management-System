<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Inventory Desk' %> | Inventory Desk</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="/"><span class="brand-mark">+</span><span>Inventory<br><b>Desk</b></span></a>
      <p class="nav-label">Workspace</p>
      <nav>
        <a class="nav-link <%= path === '/' ? 'active' : '' %>" href="/"><span>▦</span> Overview</a>
        <a class="nav-link <%= path === '/products' ? 'active' : '' %>" href="/products"><span>□</span> Products</a>
        <a class="nav-link <%= path === '/categories' ? 'active' : '' %>" href="/categories"><span>◈</span> Categories</a>
        <a class="nav-link <%= path === '/suppliers' ? 'active' : '' %>" href="/suppliers"><span>◎</span> Suppliers</a>
        <p class="nav-label second">Operations</p>
        <a class="nav-link <%= path === '/purchases' ? 'active' : '' %>" href="/purchases"><span>↓</span> Purchases</a>
        <a class="nav-link <%= path === '/sales' ? 'active' : '' %>" href="/sales"><span>↑</span> Sales</a>
        <a class="nav-link <%= path === '/reports' ? 'active' : '' %>" href="/reports"><span>◫</span> Reports</a>
      </nav>
      <div class="sidebar-foot"><span class="status-dot"></span> System operational</div>
    </aside>
    <main class="main-content">
      <header class="topbar">
        <div class="breadcrumb">Inventory Desk <span>/</span> <strong><%= title || 'Overview' %></strong></div>
        <div class="user-menu"><span class="avatar"><%= user ? user.name.charAt(0) : 'A' %></span><span><b><%= user ? user.name : 'Admin' %></b><small><%= user ? user.role : 'admin' %></small></span><form action="/logout" method="post"><button class="icon-button" title="Sign out">↪</button></form></div>
      </header>
      <div class="page-content">

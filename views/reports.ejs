<%- include('partials/header', { title: 'Reports' }) %>
<section class="page-heading"><div><p class="eyebrow">Business intelligence</p><h1>Reports</h1><p class="muted">A clear read on movement, stock, and revenue.</p></div></section><div class="report-grid"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">Performance</p><h2>Top products</h2></div></div><div class="rank-list"><% topProducts.forEach((product, index) => { %><div class="rank-row"><span class="rank"><%= String(index + 1).padStart(2, '0') %></span><div><b><%= product.name %></b><small><%= product.sku %></small></div><strong><%= product.sold %> sold</strong></div><% }) %></div></section><section class="panel"><div class="panel-heading"><div><p class="eyebrow">Inventory mix</p><h2>Units by category</h2></div></div><div class="bar-list"><% categoryStock.forEach(category => { const max = categoryStock[0] ? Number(categoryStock[0].units) || 1 : 1; %><div><div class="bar-label"><b><%= category.name %></b><span><%= category.units %> units</span></div><div class="bar"><i style="width: <%= Math.max(4, Number(category.units) / max * 100) %>%"></i></div></div><% }) %></div></section></div><section class="panel"><div class="panel-heading"><div><p class="eyebrow">Revenue trend</p><h2>Monthly sales</h2></div></div><div class="table-wrap"><table><thead><tr><th>Month</th><th>Revenue</th></tr></thead><tbody><% monthlySales.forEach(month => { %><tr><td><b><%= month.month %></b></td><td><strong>$<%= Number(month.revenue).toFixed(2) %></strong></td></tr><% }) %><% if (!monthlySales.length) { %><tr><td colspan="2" class="muted">Sales will appear here after your first transaction.</td></tr><% } %></tbody></table></div></section>
<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Reports' }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow">Business intelligence</p>
    <h1>Reports</h1>
    <p class="muted">Sales performance, best-selling products, and stock at a glance.</p>
  </div>
  <a class="button primary" href="/sales">Record a sale <span>→</span></a>
</section>

<section class="stats-grid report-stats">
  <div class="stat-card"><span class="stat-icon orange">₹</span><div><p>Total recorded revenue</p><strong><%= currencySymbol %><%= formatMoney(totals.revenue) %></strong><small>Across all recorded sales · <%= currencyCode %></small></div></div>
  <div class="stat-card"><span class="stat-icon blue">↗</span><div><p>Transactions</p><strong><%= Number(totals.transactions).toLocaleString() %></strong><small>Recorded sale invoices</small></div></div>
  <div class="stat-card"><span class="stat-icon green">□</span><div><p>Inventory</p><strong><%= Number(inventory.products).toLocaleString() %> products</strong><small><%= Number(inventory.units).toLocaleString() %> units on hand</small></div></div>
</section>

<div class="report-grid">
  <section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">Sales performance</p><h2>Best sellers</h2></div><a href="/sales" class="text-link">View sales →</a></div>
    <% if (!topProducts.length) { %>
      <div class="empty-state">Product rankings will appear after sales are recorded.</div>
    <% } else { %>
      <div class="rank-list">
        <% topProducts.forEach((product, index) => { %>
        <div class="rank-row">
          <span class="rank"><%= String(index + 1).padStart(2, '0') %></span>
          <div><b><%= product.name %></b><small><%= product.sku %> · <%= product.stock %> in stock</small></div>
          <strong><%= Number(product.sold).toLocaleString() %> sold</strong>
          <span class="rank-revenue"><%= currencySymbol %><%= formatMoney(product.revenue) %></span>
        </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="panel">
    <div class="panel-heading"><div><p class="eyebrow">Inventory mix</p><h2>Stock by category</h2></div></div>
    <% if (!categoryStock.length) { %>
      <div class="empty-state">Category stock will appear here after products are added.</div>
    <% } else { %>
      <div class="bar-list">
        <% const maxUnits = Math.max(1, ...categoryStock.map(category => Number(category.units))); %>
        <% categoryStock.forEach(category => { %>
        <div>
          <div class="bar-label"><b><%= category.name %></b><span><%= Number(category.units).toLocaleString() %> units · <%= category.products %> products</span></div>
          <div class="bar"><i style="width: <%= Math.max(2, Number(category.units) / maxUnits * 100) %>%"></i></div>
        </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>

<section class="panel report-trend">
  <div class="panel-heading"><div><p class="eyebrow">Revenue movement</p><h2>Monthly sales</h2></div></div>
  <% if (!latestSaleDate) { %>
    <div class="empty-state">Monthly trends will appear after your first sale.</div>
  <% } else { %>
    <p class="muted">Twelve months ending on the latest recorded sale (<%= new Date(`${latestSaleDate}T00:00:00Z`).toLocaleDateString(undefined, { timeZone: 'UTC' }) %>).</p>
    <% const maxRevenue = Math.max(0, ...monthlyTrend.map(point => Number(point.revenue))); %>
    <div class="chart-bars" role="img" aria-label="Monthly revenue trend">
      <% monthlyTrend.forEach(point => { const height = maxRevenue ? Math.max(3, Number(point.revenue) / maxRevenue * 100) : 3; %>
      <div class="chart-column" title="<%= point.label %>: <%= currencySymbol %><%= formatMoney(point.revenue) %> · <%= point.transactions %> transactions">
        <div class="chart-bar-track"><span class="chart-bar-fill" style="height: <%= height %>%"></span></div>
        <strong><%= currencySymbol %><%= formatRoundedMoney(point.revenue) %></strong>
        <small><%= point.label %></small>
      </div>
      <% }) %>
    </div>
  <% } %>
</section>
<%- include('partials/footer') %>
